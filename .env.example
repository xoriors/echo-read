# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# The server also reads these straight from the environment, so CI and hosting
# platforms can inject them without a file.

# Required. Powers article clean-up, summarisation, PDF reading and text-to-speech.
GEMINI_API_KEY=

# Optional. Enables the remote-browser fallback for pages that need JavaScript
# to render. Article fetching still works without it, via the reader proxy and
# a plain HTTP fetch.
BROWSERLESS_API_KEY=

# Required in production; generated per boot in development.
#
# Signs the cookie that identifies an owner, and the cookie *is* the identity —
# so if this changes, every returning visitor is issued a new owner id and
# their study decks become unreachable. Set it once and never rotate it
# casually. Generate with: openssl rand -hex 32
SESSION_SECRET=
